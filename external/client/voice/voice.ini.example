; ============================================================
;  mod-voicechat - voice.ini (neben Wow.exe / next to Wow.exe)
;  Phase 6: Server-Integration + Occlusion (mod-voicechat) / server integration + occlusion
; ============================================================

[Server]
; DE: auto       = Worldserver fragen (mod-voicechat); antwortet er nicht, eigenstaendig mit Host/Port unten
;     server     = nur ueber den Worldserver (Adresse, Name, Channel, Rechte kommen vom Server)
;     standalone = ohne Worldserver, direkt Host/Port unten (Test/Phase 4)
; EN: auto       = ask the worldserver (mod-voicechat); if it does not answer, standalone with Host/Port below
;     server     = only via the worldserver (address, name, channel, permissions come from the server)
;     standalone = without worldserver, directly Host/Port below (test/phase 4)
Mode=auto
; DE: Murmur-Server (nur standalone/Fallback). EN: Murmur server (standalone/fallback only).
Host=127.0.0.1
Port=64738
Password=
; DE: optional SHA-256 des Server-Zertifikats (steht nach dem ersten Verbinden in voice.log)
; EN: optional SHA-256 of the server certificate (logged in voice.log after the first connect)
CertSha256=
; DE: 1 = kein UDP, alles ueber TCP. EN: 1 = no UDP, everything via TCP.
ForceTcp=0

[Player]
; DE: leer = Charaktername. EN: empty = character name.
Username=
; DE: 1 = nur in der Welt verbinden, beim Logout trennen. 0 = sofort verbinden (braucht Username).
; EN: 1 = connect only while in the world, disconnect on logout. 0 = connect right away (needs Username).
AutoConnectInWorld=1

[Audio]
; ptt | vad | continuous
Mode=ptt
; DE: Taste: CAPSLOCK, F1..F24, A..Z, 0..9, LSHIFT, LCTRL, LALT, MOUSE4, MOUSE5, SPACE, TAB oder 0x..
; EN: key: CAPSLOCK, F1..F24, A..Z, 0..9, LSHIFT, LCTRL, LALT, MOUSE4, MOUSE5, SPACE, TAB or 0x..
PushToTalkKey=CAPSLOCK
; DE: Schwelle fuer Sprachaktivierung (0..1). EN: voice activation threshold (0..1).
VadThreshold=0.02
InputGain=1.0
OutputVolume=1.0
Bitrate=32000
; DE: Teil des Geraetenamens, leer = Windows-Standard. EN: part of the device name, empty = Windows default.
InputDevice=
OutputDevice=

[Spatial]
; DE: bis MinDistance volle Lautstaerke, ab MaxDistance stumm (Yards). EN: full volume up to MinDistance, silent from MaxDistance (yards).
MinDistance=3
MaxDistance=40
; DE: camera = Richtung aus Kamerasicht (3rd Person), character = Blickrichtung des Charakters.
; EN: camera = direction from the camera view (3rd person), character = the character's facing.
ListenerMode=camera
; DE: 1 = Sprecher ohne Position (z. B. Desktop-Mumble, andere Map) trotzdem hoeren. EN: 1 = still hear speakers without position.
HearWithoutPosition=0

[Occlusion]
; DE: Waende/Gelaende zwischen dir und einem Fremden daempfen die Stimme (WoW TraceLine, 3 Strahlen je Sprecher).
;     Gruppen-/Raidmitglieder sind nie betroffen.
; EN: walls/terrain between you and a stranger muffle the voice (WoW TraceLine, 3 rays per speaker).
;     Party/raid members are never affected.
Enabled=1
; DE: Pegel bei voller Verdeckung (0..1) und Tiefpass dann (Hz). EN: level when fully occluded (0..1) and low-pass then (Hz).
Gain=0.35
LowpassHz=1000
; DE: TraceLine-Flags (0x100111 = Gelaende + Gebaeude + Modelle, wie WoW selbst). EN: TraceLine flags (as WoW itself uses).
Flags=0x100111
; DE: Kopfhoehe ueber den Fuessen (Yards) und Strahlbudget pro Frame. EN: head height above the feet (yards) and ray budget per frame.
HeadHeight=1.5
RaysPerTick=9

[Ui]
; DE: 1 = Blizzard-Voice-Oberflaeche nutzen, wenn der Server es erlaubt (Voice-Optionsmenue, Sprecher-Symbole).
;     Dann gelten die Einstellungen aus dem WoW-Menue (Ein/Aus, Mikrofon, Push-to-Talk-Taste, Sprachaktivierung,
;     Lautstaerken) statt der Werte oben in [Audio]. 0 = nur voice.ini.
; EN: 1 = use the Blizzard voice UI if the server allows it (voice options menu, speaker icons).
;     The WoW menu settings (on/off, microphone, push-to-talk key, voice activation, volumes) then replace
;     the [Audio] values above. 0 = voice.ini only.
NativeUi=1

[Debug]
; DE: schreibt voice.log neben Wow.exe. EN: writes voice.log next to Wow.exe.
Log=1
